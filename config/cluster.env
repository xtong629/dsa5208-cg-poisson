# config/cluster.env -- the ONE place for cluster-specific settings and experiment sizes.
# Sourced by bash (keep it POSIX-ish: plain VAR="value" lines). Every value that is still
# CHANGE_ME must be filled in after checking the cluster (gstat, qstat -Qf <queue>, hpc cpu,
# hpc gpu, module avail); scripts/submit.sh refuses to submit while a required value is CHANGE_ME.
# Values marked (lecture) come from Lecture 8 but should still be verified.

# =========================================================================================
# 1. Experiment parameters (cluster independent) -- edit sizes here to trade accuracy for cost
# =========================================================================================
REPS=3                       # repetitions of every timing point; the plots report the MEDIAN
ITERS=100                    # fixed number of CG iterations for all timing runs
TOL=1e-8                     # relative-residual tolerance for the convergence runs
REPS_CONV=1                  # repetitions of the (more expensive) run-to-convergence serial runs

# --- serial (T_s): must contain every N used by the strong-scaling and weak-scaling baselines
SERIAL_FIXED_2D="128 256 512 1024 2048 4096 8192"
SERIAL_FIXED_3D="32 48 64 96 128 192 256 384 512"
SERIAL_CONV_2D="32 64 128 256 512 1024 2048"
SERIAL_CONV_3D="8 16 32 48 64 96 128"

# --- MPI scaling. Rank counts (powers of two; add 512 only if the allocation allows it)
NP_LIST="1 2 4 8 16 32 64 128 256"
NP_EXTRA=""                  # e.g. "512"
STRONG_N_2D="4096 8192"      # fixed global problem sizes (points per axis)
STRONG_N_3D="256 512"
STRONG_MAX_PTS_PER_RANK=17000000   # skip rank counts whose subdomain would exceed this (saves core-hours:
                                   # the baseline for large sizes is the serial program, not 1 rank)
WEAK_BASE_2D="1024 2048"     # points per axis on ONE rank; N(n) = round(base * n^(1/dim))
WEAK_BASE_3D="64 128"
MIN_PTS_PER_RANK=1000        # skip degenerate runs with fewer points than this per rank

# --- decomposition / halo-variant comparison
DH_NP_LIST="4 16 64 256"
DH_N_2D=4096
DH_N_3D=256

# --- hybrid MPI+OpenMP at fixed total core counts: ranks = total / threads
HYB_TOTAL_CORES="64 256"
HYB_THREADS="1 2 4 8 16"
HYB_N_2D=4096
HYB_N_3D=256

# --- GPU (Vanda only)
GPU_SIZES_2D="256 512 1024 2048 4096 8192"
GPU_SIZES_3D="32 64 96 128 192 256 384"
GPU_MULTI_N_2D=8192
GPU_MULTI_N_3D=384

# --- requested walltimes (upper bounds; PBS kills the job at this limit). Adjust after the first runs.
WALL_SERIAL="02:00:00"
WALL_STRONG="00:30:00"       # per job (one job per node count, see JOB_SPLIT)
WALL_WEAK="00:30:00"
WALL_MULTINODE="00:15:00"    # used instead of the above for jobs with more than one node (a 256-rank run takes minutes)
WALL_DECOMP_HALO="00:20:00"
WALL_HYBRID="00:20:00"
WALL_GPU_SWEEP="00:30:00"
WALL_GPU_MULTI="00:30:00"

# JOB_SPLIT=tiered : one job per node count (a 1-node job for np <= cores/node, a 2-node job for
#                    the next tier, ...), so small runs do not occupy a 256-core allocation.
# JOB_SPLIT=single : one job sized for the largest np (fewer queue waits, more idle cores).
JOB_SPLIT="tiered"

# =========================================================================================
# 2. Atlas  (CPU only, unlimited use; login: ssh <user>@atlas8.nus.edu.sg; compile on the login node)
# =========================================================================================
ATLAS_ENV_INIT="source /app1/ebenv"       # (lecture) then `module avail` / `module load`
ATLAS_MODULES_CPU="CHANGE_ME"             # e.g. "module load <compiler> <openmpi>"  -- see `module avail`
ATLAS_MAKE_FLAGS=""                       # extra flags for `make`, e.g. OMPFLAGS=-mp for nvc++
ATLAS_QUEUE="CHANGE_ME"                   # from `qstat -Qf <queue>` / `hpc cpu`
ATLAS_PROJECT=""                          # PBS project/account (-P), empty if not needed
ATLAS_CORES_PER_NODE="CHANGE_ME"          # physical cores per node
ATLAS_MAX_CORES_PER_JOB="CHANGE_ME"       # from the queue limits; must be >= 256 for the scaling runs
ATLAS_SELECT_CPU="select={NODES}:ncpus={CPN}:mpiprocs={CPN}"   # PBS Pro select string; {NODES} {CPN} substituted
ATLAS_SELECT_SERIAL="select=1:ncpus=1:mem=8gb"                 # serial job: raise mem for the biggest sizes
ATLAS_MPIRUN="mpirun"                     # launcher (+ flags); e.g. "mpirun" or "mpiexec"
ATLAS_MPI_BIND="--bind-to core"           # pin one rank per core (pure MPI). Flag syntax depends on the MPI library
ATLAS_HYBRID_BIND="--map-by slot:PE={T} --bind-to core"   # hybrid: {T} threads per rank reserved per rank
ATLAS_OMP_PLACES="cores"                  # OMP_PLACES for hybrid runs
ATLAS_OMP_PROC_BIND="close"               # OMP_PROC_BIND for hybrid runs

# Policy: all CPU experiments run on Atlas (unlimited use) -- including the serial runs, so that
# T_s and T_p(n) come from the same hardware. Vanda is reserved for the GPU experiments. To also
# run CPU experiments on Vanda (only if its allocation is clearly sufficient), pass
# --allow-vanda-cpu to scripts/submit.sh.

# =========================================================================================
# 3. Vanda  (CPU + GPU (A40), limited core-hour allocation; compile inside an interactive job)
# =========================================================================================
VANDA_ENV_INIT=""                         # usually nothing needed; set if `module` is not available
VANDA_MODULES_CPU="CHANGE_ME"             # CPU build/run modules (could be the nvhpc one, see below)
VANDA_MODULES_GPU="module load nvhpc-hpcx-cuda12/26.1"   # (lecture, recommended). Alternative:
                                          # module load OpenMPI/4.1.4-NVHPC-22.7-CUDA-11.7.0
VANDA_MAKE_FLAGS=""                       # for CPU builds with nvc++ use OMPFLAGS=-mp (and CXX=nvc++ MPICXX=mpicxx)
VANDA_QUEUE="CHANGE_ME"                   # CPU queue
VANDA_GPU_QUEUE="CHANGE_ME"               # GPU queue
VANDA_PROJECT=""
VANDA_CORES_PER_NODE="CHANGE_ME"
VANDA_MAX_CORES_PER_JOB="CHANGE_ME"
VANDA_SELECT_CPU="select={NODES}:ncpus={CPN}:mpiprocs={CPN}"
VANDA_SELECT_SERIAL="select=1:ncpus=1:mem=8gb"
VANDA_GPUS_PER_NODE="CHANGE_ME"           # GPUs you may request in one job on one node (for gpu_multi)
VANDA_GPU_NODE_CPUS="CHANGE_ME"           # CPU cores requested together with the GPU(s); also used for the CPU-node reference
VANDA_SELECT_GPU="select=1:ncpus={CPUS}:mpiprocs={GPUS}:ngpus={GPUS}"   # {CPUS} {GPUS} substituted
VANDA_MPIRUN="mpirun"
VANDA_MPI_BIND="--bind-to core"
VANDA_HYBRID_BIND="--map-by slot:PE={T} --bind-to core"
VANDA_OMP_PLACES="cores"
VANDA_OMP_PROC_BIND="close"
CUDA_ARCH="sm_86"                         # A40 = sm_86
VANDA_CUDA_MAKE_FLAGS=""                  # e.g. CUDA_EXTRA=-DHOST_STAGING

# =========================================================================================
# 4. LOCAL  -- smoke tests on the development machine (NOT for any reported result)
# =========================================================================================
LOCAL_ENV_INIT=""
LOCAL_MODULES_CPU=""
LOCAL_MAKE_FLAGS=""
LOCAL_QUEUE="none"
LOCAL_PROJECT=""
LOCAL_CORES_PER_NODE=8
LOCAL_MAX_CORES_PER_JOB=8
LOCAL_SELECT_CPU="n/a"
LOCAL_SELECT_SERIAL="n/a"
LOCAL_MPIRUN="mpirun --oversubscribe"
LOCAL_MPI_BIND=""
LOCAL_HYBRID_BIND=""
LOCAL_OMP_PLACES="cores"
LOCAL_OMP_PROC_BIND="false"

# Tiny sizes used when SMOKE=1 (local pipeline test: scripts and plots only)
SMOKE_OVERRIDES() {
  REPS=2; ITERS=20; TOL=1e-6; REPS_CONV=1
  SERIAL_FIXED_2D="32 64 128"; SERIAL_FIXED_3D="8 16 24 32"
  SERIAL_CONV_2D="16 32 64"; SERIAL_CONV_3D="8 12 16"
  NP_LIST="1 2 4 8"; NP_EXTRA=""
  STRONG_N_2D="128"; STRONG_N_3D="32"; STRONG_MAX_PTS_PER_RANK=1000000
  WEAK_BASE_2D="32"; WEAK_BASE_3D="12"
  DH_NP_LIST="2 4 8"; DH_N_2D=128; DH_N_3D=32
  HYB_TOTAL_CORES="4 8"; HYB_THREADS="1 2 4"; HYB_N_2D=128; HYB_N_3D=32
}
