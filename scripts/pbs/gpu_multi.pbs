#!/bin/bash
#PBS -N p3_gpu_multi
#PBS -j oe
# Experiment "gpu_multi". Resources (queue, select=..., walltime) are NOT hard-coded: scripts/submit.sh
# builds them from config/cluster.env and passes them to qsub, e.g.
#   bash scripts/submit.sh atlas gpu_multi --dry-run     # show the qsub command(s) and the core-hour bound
#   bash scripts/submit.sh atlas gpu_multi               # submit
# Manual submission (from the repository root):
#   qsub -q <queue> -l select=<nodes>:ncpus=<cores>:mpiprocs=<cores> -l walltime=HH:MM:SS \
#        -v CLUSTER=<atlas|vanda>,NP_LIST_JOB=<np1:np2:...> scripts/pbs/gpu_multi.pbs
cd "${PBS_O_WORKDIR:?submit this job from the repository root}"
exec bash scripts/run_all.sh "${CLUSTER:?pass -v CLUSTER=atlas|vanda}" gpu_multi
